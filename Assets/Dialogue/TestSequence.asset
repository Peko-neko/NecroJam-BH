  lines:
  - speakerName: Ava
    text: Hey... is someone there?
    portrait: {fileID: 0}
    portraitTint: {r: 0.55, g: 0.75, b: 1, a: 1}
    side: 0
    typingSpeedOverride: -1
  - speakerName: Rook
    text: Just me. Didn't mean to startle you.
    portrait: {fileID: 0}
    portraitTint: {r: 1, g: 0.7, b: 0.55, a: 1}
    side: 1
    typingSpeedOverride: -1
  - speakerName: Ava
    text: You scared me half to death!
    portrait: {fileID: 0}
    portraitTint: {r: 0.55, g: 0.75, b: 1, a: 1}
    side: 0
    typingSpeedOverride: -1
  - speakerName: Ava
    text: ...I really need to stop coming down here alone.
    portrait: {fileID: 0}
    portraitTint: {r: 0.55, g: 0.75, b: 1, a: 1}
    side: 2
    typingSpeedOverride: -1
